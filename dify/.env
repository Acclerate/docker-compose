# ======================
# 核心安全密钥（必须修改！生产环境请用随机强密钥）
# ======================
SECRET_KEY=sk-DifyLocalDeployKey-ChangeThisToStrongRandomString2025
API_KEY=dify-local-api-key-please-change

# 应用基本信息
APP_NAME=Dify
APP_ENV=production

# ======================
# 数据库 PostgreSQL（与 docker-compose 中的环境变量对应）
# ======================
DB_HOST=db
DB_PORT=5432
DB_USERNAME=dify          # ✅ 与 docker-compose 统一
DB_PASSWORD=dify_password    # ✅ 与 docker-compose 统一
DB_DATABASE=dify
DB_CHARSET=utf8
DB_CONNECTION=postgres
# ======================
# Redis（本地无密码示例）
# ======================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ======================
# Weaviate 向量数据库
# ======================
WEAVIATE_HOST=weaviate
WEAVIATE_PORT=8080
WEAVIATE_URL=http://weaviate:8080
VECTOR_STORE=weaviate

# ======================
# 外部访问 URL（最关键！浏览器和 API 互相访问用）
# ======================
CONSOLE_WEB_URL=http://127.0.0.1:8650
CONSOLE_API_URL=http://127.0.0.1:5001
SERVICE_API_URL=http://127.0.0.1:5001
APP_WEB_URL=http://127.0.0.1:8650
APP_API_URL=http://127.0.0.1:5001

# ======================
# 存储 & 文件上传
# ======================
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=/app/storage
FILE_UPLOAD_MAX_FILE_SIZE=52428800
FILE_UPLOAD_ALLOWED_EXTENSIONS=jpg,jpeg,png,gif,pdf,doc,docx,txt,xlsx,xls,csv,md

# ======================
# CORS（本地开发常用）
# ======================
CORS_ALLOWED_ORIGINS=http://localhost:8650,http://127.0.0.1:8650

# ======================
# 日志 & 其他
# ======================
LOG_LEVEL=INFO
CELERY_BACKEND=database
DEBUGBAR_ENABLED=false

# ======================
# 插件配置（可选）
# ======================
ENABLE_PLUGIN_DAEMON=true
ENABLE_MARKETPLACE=true

# ======================
# 邮件配置（可选，用于注册/重置密码）
# ======================
# MAIL_TYPE=smtp
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM_NAME=Dify

# ======================
# OAuth 配置（可选）
# ======================
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ======================
# LLM 配置（可选）
# ======================
# OPENAI_API_KEY=sk-xxx
# OPENAI_API_BASE=https://api.openai.com/v1