{
  "mcpServers": {
    "fetch": {
      "command": "uvx",
      "args": [
        "mcp-server-fetch"
      ],
      "fromGalleryId": "modelcontextprotocol.servers_fetch"
    },
    "filesystem": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "--mount",
        "type=bind,src=D://IdeaProjects,dst=/ideaprojects",
        "--mount",
        "type=bind,src=D://privategit,dst=/privategit",
        "mcp/filesystem",
        "/ideaprojects /privategit"
      ]
    },
    "sequentialthinking": {
      "command": "docker",
      "args": [
        "run",
        "--rm",
        "-i",
        "mcp/sequentialthinking"
      ]
    },
    "everything-search": {
      "command": "uvx",
      "args": [
        "mcp-server-everything-search"
      ],
      "env": {
        "EVERYTHING_SDK_PATH": "D:\\tools\\Everything-SDK\\dll\\Everything64.dll"
      }
    },
    "github": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-e",
        "GITHUB_PERSONAL_ACCESS_TOKEN=your_github_personal_access_token_here",
        "mcp-github-server"
      ]
    }
  }
}