{
  "mcpServers": {
    "fetch": {
      "command": "uvx",
      "args": [
        "mcp-server-fetch"
      ],
      "fromGalleryId": "modelcontextprotocol.servers_fetch",
      "disabled": false
    },
    "filesystem": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "--mount",
        "type=bind,src=D://IdeaProjects,dst=/ideaprojects",
        "--mount",
        "type=bind,src=D://privategit,dst=/privategit",
        "server-filesystem",
        "/ideaprojects",
        "/privategit"
      ]
    },
    "sequentialthinking": {
      "command": "docker",
      "args": [
        "run",
        "--rm",
        "-i",
        "mcp/sequentialthinking"
      ]
    },
    "context7-mcp": {
      "command": "docker",
      "args": [
        "run",
        "-v",
        "--rm",
        "-i",
        "-p",
        "4000:4000",
        "context7-mcp-server"
      ]
    },
    "everything-search": {
      "command": "uvx",
      "args": [
        "mcp-server-everything-search"
      ],
      "env": {
        "EVERYTHING_SDK_PATH": "D:\\tools\\Everything-SDK\\dll\\Everything64.dll"
      },
      "disabled": false
    },
    "Figma AI Bridge": {
      "command": "docker",
      "args": [
        "run",
        "--rm",
        "-i",
        "-e",
        "FIGMA_API_KEY=your_figma_api_key_here",
        "figma-mcp-server",
        "figma-developer-mcp",
        "--stdio"
      ],
      "disabled": true
    },
    "github": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-e",
        "GITHUB_PERSONAL_ACCESS_TOKEN=your_github_personal_access_token_here",
        "mcp-github-server"
      ],
      "disabled": false
    }
  }
}