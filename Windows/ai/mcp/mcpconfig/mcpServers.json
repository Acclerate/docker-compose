{
  "mcpServers": {
    "fetch": {
      "command": "uvx",
      "args": [
        "mcp-server-fetch"
      ],
      "fromGalleryId": "modelcontextprotocol.servers_fetch",
      "disabled": false
    },
    "filesystem": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "--mount",
        "type=bind,src=D://IdeaProjects,dst=/ideaprojects",
        "--mount",
        "type=bind,src=D://privategit,dst=/privategit",
        "server-filesystem",
        "/ideaprojects",
        "/privategit"
      ]
    },
    "sequentialthinking": {
      "command": "docker",
      "args": [
        "run",
        "--rm",
        "-i",
        "mcp/sequentialthinking"
      ]
    },
    "context7-mcp": {
      "command": "docker",
      "args": [
        "run",
        "-v",
        "--rm",
        "-i",
        "-p",
        "4000:4000",
        "context7-mcp-server"
      ]
    },
    "everything-search": {
      "command": "uvx",
      "args": [
        "mcp-server-everything-search"
      ],
      "env": {
        "EVERYTHING_SDK_PATH": "D:\\tools\\Everything-SDK\\dll\\Everything64.dll"
      },
      "disabled": false
    },
    "Figma AI Bridge": {
      "command": "docker",
      "args": [
        "run",
        "--rm",
        "-i",
        "-e",
        "FIGMA_API_KEY=your_figma_api_key_here",
        "figma-mcp-server",
        "figma-developer-mcp",
        "--stdio"
      ],
      "disabled": true
    },
    "github": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-e",
        "GITHUB_PERSONAL_ACCESS_TOKEN=your_github_personal_access_token_here",
        "mcp-github-server"
      ],
      "disabled": false
    }
  }



  ,

  "context7": {
      "command": "D:\\tools\\nvm\\v20.9.0\\node.exe",
      "args": [
        "C:\\Users\\Administrator\\AppData\\Local\\pnpm\\global\\5\\node_modules\\@upstash\\context7-mcp\\dist\\index.js"
      ],
      "disabled": false
    },
    "mysql": {
      "command": "D:\\tools\\nvm\\v20.9.0\\node.exe",
      "args": [
        "C:\\Users\\Administrator\\AppData\\Local\\pnpm\\global\\5\\node_modules\\@benborla29\\mcp-server-mysql\\dist\\index.js"
      ],
      "env": {
        "MYSQL_HOST": "127.0.0.1",
        "MYSQL_PORT": "3306",
        "MYSQL_USER": "root",
        "MYSQL_PASS": "root",
        "MYSQL_DB": "",
        "ALLOW_INSERT_OPERATION": "true",
        "ALLOW_UPDATE_OPERATION": "true",
        "ALLOW_DELETE_OPERATION": "true"
      },
      "disabled": false
    },
    "playwright": {
      "type": "http",
      "url": "http://localhost:18002/mcp"
    },
    "web-reader": {
      "headers": {
        "Authorization": "Bearer xxxxxxxxxxxxxxxxxxxx.xxxxxxxxxx"
      },
      "type": "http",
      "url": "https://open.bigmodel.cn/api/mcp/web_reader/mcp"
    },
    "web-search-prime": {
      "headers": {
        "Authorization": "Bearer xxxxxxxxxxxxxxxxxxxx.xxxxxxxxxx"
      },
      "type": "http",
      "url": "https://open.bigmodel.cn/api/mcp/web_search_prime/mcp"
    },
    "zread": {
      "headers": {
        "Authorization": "Bearer xxxxxxxxxxxxxxxxxxxx.xxxxxxxxxx"
      },
      "type": "http",
      "url": "https://open.bigmodel.cn/api/mcp/zread/mcp"
    },
    "zai-mcp-server": {
      "command": "D:\\tools\\nvm\\v20.9.0\\node.exe",
      "args": [
        "D:\\tools\\bun_data\\node_modules\\@z_ai\\mcp-server\\build\\index.js"
      ],
      "env": {
        "Z_AI_API_KEY": "xxxxxxxxxxxxxxxxxxxx.xxxxxxxxxx",
        "Z_AI_MODE": "ZHIPU"
      },
      "type": "stdio"
    }
}


